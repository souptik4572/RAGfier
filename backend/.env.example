# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_DB_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=documents

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic contextual retrieval (optional)
ANTHROPIC_API_KEY=
CONTEXTUALIZATION_ENABLED=false
CONTEXTUALIZER_MODEL=claude-haiku-4-5-20251001
CONTEXTUALIZER_MAX_TOKENS=150
CONTEXTUALIZER_MAX_CONCURRENCY=5
CONTEXTUALIZER_MAX_DOC_CHARS=180000

# LlamaParse
LLAMA_CLOUD_API_KEY=llx-...

# Application
APP_ENV=development
APP_VERSION=0.1.0
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,md
# Optional alias still accepted on filenames: .markdown -> md
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
EMBEDDING_BATCH_SIZE=100
SIGNED_URL_EXPIRY_SECONDS=3600

# Optional
REDIS_URL=redis://localhost:6379/0

# Query rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
# Optional override when not using REDIS_URL
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=250
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_STREAM_SLOT_TTL_SECONDS=300
RATE_LIMIT_JWT_QUERY_REQUESTS_PER_WINDOW=30
RATE_LIMIT_JWT_STREAM_REQUESTS_PER_WINDOW=12
RATE_LIMIT_JWT_STREAM_CONCURRENCY=3
RATE_LIMIT_API_KEY_QUERY_REQUESTS_PER_WINDOW=60
RATE_LIMIT_API_KEY_STREAM_REQUESTS_PER_WINDOW=20
RATE_LIMIT_API_KEY_STREAM_CONCURRENCY=5

# Phase 3: Evaluation pipeline
EVAL_DATASET_PATH=eval/datasets/golden_v1.0.0.json
EVAL_THRESHOLDS_PATH=eval/config/thresholds.yaml
EVAL_LLM_JUDGE=gpt-4o-mini
EVAL_FAITHFULNESS_LLM=gpt-4o
EVAL_TIMEOUT_SECONDS=300
EVAL_MAX_CONCURRENCY=5
EVAL_LATENCY_BUDGET_MS=5000
EVAL_REPORTS_DIR=eval/reports
RAGAS_DO_NOT_TRACK=true

EVAL_THRESHOLD_FAITHFULNESS=0.85
EVAL_THRESHOLD_ANSWER_RELEVANCY=0.80
EVAL_THRESHOLD_CONTEXT_PRECISION=0.75
EVAL_THRESHOLD_CONTEXT_RECALL=0.75
EVAL_THRESHOLD_CITATION_COVERAGE=0.90
EVAL_THRESHOLD_DECLINE_ACCURACY=0.80
EVAL_THRESHOLD_LATENCY_COMPLIANCE=0.90
